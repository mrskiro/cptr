{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn", "oxc", "import", "jsx-a11y", "vitest"],
  "jsPlugins": ["./oxlint-plugin.mjs"],
  "rules": {
    "oxc/no-barrel-file": ["error", { "threshold": 1 }],
    "vitest/consistent-test-it": ["error", { "fn": "it", "withinDescribe": "it" }],
    "react/forbid-dom-props": [
      "error",
      {
        "forbid": [
          {
            "propName": "style",
            "message": "style attribute is only allowed for properties determined dynamically at runtime"
          }
        ]
      }
    ],
    "custom-rules/no-use-effect": "error",
    "custom-rules/no-use-ref": "error"
  }
}
